{
  "name": "tingyu-ai-music",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "admin:set": "node --env-file-if-exists=.env scripts/admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "agent-browser": "^0.21.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
