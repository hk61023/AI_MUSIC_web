[Unit]
Description=Tingyu AI music gallery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tingyu
Group=tingyu
WorkingDirectory=/opt/tingyu/current
EnvironmentFile=/etc/tingyu.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tingyu
UMask=0077
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
