{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": { "age": 30, "matchesPrefix": ["backups/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "isLive": false,
        "numNewerVersions": 3,
        "daysSinceNoncurrentTime": 7
      }
    }
  ]
}
