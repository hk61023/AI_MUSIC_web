HOST=127.0.0.1
PORT=8787
WEB_PORT=5173
SITE_ORIGIN=http://localhost:5173
DATA_DIR=./data
# NODE_ENV is set to production only on the production server.
# Production: gcs. Keep the bucket private, use VM service account ADC.
STORAGE_DRIVER=local
GCS_BUCKET=
# Optional absolute paths if FFmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Production SITE_ORIGIN must be the exact https://domain, no trailing slash.
# Set your password via npm run admin:set; no password in this file is necessary.
# Production always requires Google Authenticator enrollment. Set 1 to require it locally too.
MFA_REQUIRED=0
# Optional: persistent 32-byte binary encryption key file, auto-created mode 600.
# Back up this file securely and separately from SQLite; never commit or upload it with database backups.
# MFA_KEY_FILE=/var/lib/tingyu/mfa.key
